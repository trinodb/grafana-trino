# By default `yarn server` is fully self-contained: it bundles its own
# Trino instance (see docker-compose.yaml) and needs no configuration.
#
# Copy this file to `.env` only if you want to point the dev stack at a
# *different* Trino instance instead (e.g. a real internal cluster). Only
# fill in the section that matches your auth setup; leave the rest blank.
# See provisioning/README.md for details.

# --- Connection ---
# Overrides the bundled `trino` service. Use http://host.docker.internal:8080
# to reach a Trino running on your host machine instead of inside Docker.
TRINO_URL=
TRINO_TLS_SKIP_VERIFY=false

# --- Basic auth (optional) ---
TRINO_BASIC_AUTH_ENABLED=false
TRINO_BASIC_AUTH_USER=
TRINO_BASIC_AUTH_PASSWORD=

# --- Access token auth (optional) ---
TRINO_ACCESS_TOKEN=

# --- OAuth client-credentials auth (optional) ---
TRINO_TOKEN_URL=
TRINO_CLIENT_ID=
TRINO_CLIENT_SECRET=

# --- Trino-specific options ---
TRINO_ENABLE_IMPERSONATION=false
TRINO_IMPERSONATION_USER=
TRINO_ROLES=
TRINO_CLIENT_TAGS=

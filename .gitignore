# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

node_modules/

# Yarn (Berry) local state. The yarn binary itself comes from corepack, so
# nothing under .yarn/ needs to be committed.
.yarn/*
!.yarn/patches
.pnp.*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Compiled binary addons (https://nodejs.org/api/addons.html)
dist/
artifacts/
work/
ci/
e2e-results/

# Editor
.idea
.vscode

# Lint cache (the lint script runs eslint with --cache)
.eslintcache

# Playwright
playwright-report/
test-results
